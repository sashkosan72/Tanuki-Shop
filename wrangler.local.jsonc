{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanuki-shop-local",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanuki-shop-local-db",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "tanuki-shop-local-images",
      "remote": false
    }
  ]
}
