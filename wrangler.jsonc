{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanuki-shop",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanuki-shop-db",
      "database_id": "ed78409a-d25e-4c82-841b-f73b78944bc2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "tanuki-shop-images"
    }
  ],
  "env": {
    "preview": {
      "name": "tanuki-shop-preview-pr6",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "preview",
        "SITE_ORIGIN": "https://tanuki-shop-preview-pr6.sashh4051.workers.dev",
        "CUSTOMER_AUTH_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanuki-shop-preview-20261023",
          "database_id": "22a1fb18-c698-4753-b07d-4a98a9aac60a"
        }
      ],
      "r2_buckets": []
    }
  }
}
