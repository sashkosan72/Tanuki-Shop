{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanuki-shop",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanuki-shop-db",
      "database_id": "ed78409a-d25e-4c82-841b-f73b78944bc2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "tanuki-shop-images"
    }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "EMAIL_FROM": "noreply@tanukishop.pp.ua"
  },
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMITER",
      "namespace_id": "92836113",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "ORDER_RATE_LIMITER",
      "namespace_id": "92836114",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "CUSTOMER_AUTH_LIMITER",
      "namespace_id": "92836115",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
